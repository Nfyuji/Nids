# نسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///nids.db

# حساب المسؤول الأولي (يُنشأ مرة واحدة فقط إن لم يوجد مستخدمون)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@localhost

# واجهة الشبكة للالتقاط (مثال: Ethernet أو Wi-Fi)
CAPTURE_INTERFACE=
CAPTURE_BPF_FILTER=tcp or udp or icmp

# مسار ملف Suricata EVE JSON (اتركه فارغاً إن لم يكن مثبتاً)
SURICATA_EVE_PATH=

# المنطقة الزمنية
TIMEZONE=Asia/Riyadh

# الاحتفاظ بالسجلات (أيام)
LOG_RETENTION_DAYS=30

# لا تفعّل Debug في الإنتاج
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# السمة الرسمية: light (يمكن التبديل إلى dark من الواجهة)
THEME_DEFAULT=light
